# Local Postgres only. src/server/db.ts refuses any host other than localhost or 127.0.0.1.
DATABASE_URL=postgres://quotedesk:quotedesk@localhost:5432/quote_desk_dev
EVAL_DATABASE_URL=postgres://quotedesk:quotedesk@localhost:5432/quote_desk_eval

# Claude. Put the real key in .env.local, which git ignores.
ANTHROPIC_API_KEY=
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_MATCH=claude-haiku-4-5-20251001
MODEL_WRITE=claude-sonnet-5-5

# anthropic = real Claude calls. oracle = answer-key stand-in for testing without a key (never for results).
LLM_MODE=anthropic
# on = replay identical requests from the llm_calls table; off = always call the API.
LLM_CACHE=on

# Claude's part matches below this confidence go to the "Needs a part" queue. A number above 0 and at most 1.
MATCH_THRESHOLD=0.80
